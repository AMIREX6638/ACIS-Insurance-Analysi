# === A. Load Data ===
import pandas as pd
df = pd.read_csv('../data/raw/insurance_data.csv')
print("Data loaded. Shape:", df.shape)
df.head()

# === B. Data Checks ===
print("Missing values:\n", df.isnull().sum())
print("\nDuplicates:", df.duplicated().sum())
df['claim_amount'].plot(kind='box', title="Outliers Check")

# === C. Descriptive Stats ===
df.describe(include='all')

# === D. Univariate Analysis ===
df['claim_amount'].hist(bins=30)
df.groupby('coverage_type')['premium'].mean().plot(kind='bar')

# === E. Bivariate Analysis ===
import seaborn as sns
sns.heatmap(df.corr(), annot=True)
sns.boxplot(x='region_type', y='claim_amount', data=df)

# === F. Creative Visuals ===
# 1. Geographic Heatmap (if lat/long columns exist)
import folium
m = folium.Map(location=[df['latitude'].mean(), df['longitude'].mean()])
display(m)  # Shows map in notebook

# 2. Sunburst Chart
import plotly.express as px
fig = px.sunburst(df, path=['region', 'vehicle_type'], values='claim_amount')
fig.show()

# 3. Time Trends (if date column exists)
df['policy_date'] = pd.to_datetime(df['policy_date'])
df.set_index('policy_date')['claim_amount'].resample('M').sum().plot()